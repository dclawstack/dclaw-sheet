# Copy to .env.local and fill in. See SETUP-KEYS.md for where to get each value.

# Neon Postgres — pooled connection string (postgresql://...-pooler...)
DATABASE_URL=

# OpenRouter (AI)
OPENROUTER_API_KEY=
OPENROUTER_MONTHLY_CAP_USD=
# OPENROUTER_SITE_URL=https://dclaw-sheet.vercel.app

# Auth: "dev" auto-grants a default user (zero-config). "clerk" for prod.
AUTH_PROVIDER=dev
DEV_USER_EMAIL=dev@dclawstack.local
DEV_WORKSPACE=Demo Workspace
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Connectors (optional)
STRIPE_TEST_RESTRICTED_KEY=

APP_ENV=dev
